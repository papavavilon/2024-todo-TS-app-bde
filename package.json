{
  "name": "daytwobeforeclass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest --run src/main.test.ts --environment jsdom",
    "test:e2e": "testcafe chrome:headless src/e2e.test.ts --skip-js-errors",
    "e2e:serve": "vite --port 5173",
    "e2e:run": "wait-on http://localhost:5173 && npm run test:e2e",
    "test:e2e:ci": "npm-run-all -p -r e2e:serve e2e:run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/jsdom": "^27.0.0",
    "jsdom": "^27.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "wait-on": "^9.0.1",
    "testcafe": "^3.7.2"
  },
  "dependencies": {
  }
}
